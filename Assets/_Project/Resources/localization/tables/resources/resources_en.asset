  m_TableData:
  - m_Id: 11893772288
    m_Localized: "\u0426\u0438\u0444\u0440\u043E\u0440\u0443\u0431\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 16633335808
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0438\u0433\u0440\u043E\u0432\u0430\u044F
      \u0432\u0430\u043B\u044E\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u0432\u0441\u0435\u043C\u0435\u0441\u0442\u043D\u043E.
      \u042F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0430\u043D\u0430\u043B\u043E\u0433\u043E\u043C
      \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u0434\u0435\u043D\u0435\u0433,
      \u043D\u043E \u0432 \u0446\u0438\u0444\u0440\u043E\u0432\u043E\u0439 \u0444\u043E\u0440\u043C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5525226688512
    m_Localized: "\u041B\u0430\u0439\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 5528015900672
    m_Localized: "\u041F\u0440\u0435\u043C\u0438\u0443\u043C-\u0432\u0430\u043B\u044E\u0442\u0430,
      \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0430\u044F
      \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0442\u0430\u0442\u0443\u0441
      \u0438\u0433\u0440\u043E\u043A\u0430 \u0432 \u043C\u0438\u0440\u0435 \u0434\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u043E\u0432.
      \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u0430\u0439\u043A\u043E\u0432
      \u0443 \u0432\u0430\u0441 \u0432 \u0430\u0440\u0441\u0435\u043D\u0430\u043B\u0435
      \u2014 \u0442\u0435\u043C \u0432\u044B\u0448\u0435 \u0432\u0430\u0448 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0434\u043E\u0432\u0435\u0440\u0438\u044F \u0441\u0440\u0435\u0434\u0438 NPC
      \u0438 \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439
      \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
